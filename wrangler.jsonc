{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miutif",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Base de données (artistes + abonnements). Wrangler la crée tout seul au premier déploiement.
  "kv_namespaces": [{ "binding": "DB", "id": "ab975aac3e264976a77b8a68aa1ce6ee" }],
  // Fichier des sorties publié chaque heure par le robot GitHub (.github/workflows/sorties.yml)
  "vars": { "DATA_URL": "https://raw.githubusercontent.com/yoansadek-hue/Miutif/data/releases.json" },
  // Réveil toutes les heures : chaque téléphone est notifié quand il est 11 h chez lui.
  // et à :45, il lance le robot GitHub (secret GITHUB_TOKEN), pour des nouveautés toujours fraîches.
  "triggers": { "crons": ["0 * * * *", "45 * * * *"] },
  "observability": { "enabled": true }
}
